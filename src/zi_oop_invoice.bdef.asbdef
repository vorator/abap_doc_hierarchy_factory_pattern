managed implementation in class zbp_i_oop_invoice unique;
strict ( 2 );

define behavior for ZI_OOP_INVOICE alias Invoice
persistent table zoop_invoice
lock master
authorization master ( instance )
etag master ModifiedAt
{
  create ( authorization : global );
  update;
  delete;

  field ( numbering : managed, readonly ) InvoiceId;
  field ( mandatory ) Status, CreatedBy, CreatedAt, ModifiedBy, ModifiedAt;
  field ( mandatory ) VendorId, Amount, Currency, DcIndicator;

  validation validateOORules on save { field Amount, DcIndicator; create; update; }

  mapping for zoop_invoice {
    InvoiceId = invoice_id;
    VendorId    = vendor_id;
    VendorName  = vendor_name;
    Amount      = amount;
    Currency    = currency;
    InvoiceDate = invoice_date;
    DcIndicator = dc_indicator;
    Status      = status;
    Description = description;
    CreatedBy   = created_by;
    CreatedAt   = created_at;
    ModifiedBy  = modified_by;
    ModifiedAt  = modified_at;
  }
}